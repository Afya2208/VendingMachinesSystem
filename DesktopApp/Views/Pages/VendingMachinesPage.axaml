<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             Loaded="Page_OnLoaded"
             Name="Page"
             xmlns:vm="clr-namespace:DesktopApp.ViewModels.Pages"
             x:DataType="vm:VendingMachinesPageViewModel"
             x:Class="DesktopApp.Views.Pages.VendingMachinesPage">
    <Grid>
        <StackPanel>
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Classes="H1">Торговые автоматы</TextBlock>
                    <TextBlock Text="{Binding TotalCount,
                    StringFormat={}Всего найдено {0} шт.}"></TextBlock>
                </StackPanel>
                <StackPanel Spacing="5" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Classes="ChooseButton"
                            Command="{Binding ShowInTableRegimeCommand}"
                            IsEnabled="{Binding !TableRegime}"
                    >Таблица</Button>
                    <Button Classes="ChooseButton"
                            IsEnabled="{Binding TableRegime}"
                            Command="{Binding ShowInPanelRegimeCommand}"
                    >Плитка</Button>
                </StackPanel>
            </Grid>
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="5">
                    <TextBlock VerticalAlignment="Center">Показать</TextBlock>
                    <ComboBox ItemsSource="{Binding PageLimits}"
                              SelectedItem="{Binding PageLimit}">
                    </ComboBox>
                    <TextBlock VerticalAlignment="Center">записей</TextBlock>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Spacing="5" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBox Watermark="Поиск" Text="{Binding SearchText}"></TextBox>
                </StackPanel>
                <StackPanel Spacing="5" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Margin="0 10">
                    <Button Command="{Binding AddCommand}">Добавить</Button>
                    <Button Click="CsvMenuItem_OnClick" Content="Экспорт">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Click="CsvMenuItem_OnClick" Header="В .csv"></MenuItem>
                                <MenuItem Click="PdfMenuItem_OnClick" Header="В .pdf"></MenuItem>
                                <MenuItem Click="HtmlMenuItem_OnClick" Header="В .html"></MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
            <DataGrid ItemsSource="{Binding Machines}" 
                      IsReadOnly="True" CanUserResizeColumns="True"
                      MaxHeight="500"
                      IsVisible="{Binding TableRegime}">
                <DataGrid.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"></Setter>
                        <Setter Property="TextWrapping" Value="Wrap"></Setter>
                        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                        <Setter Property="Margin" Value="5 0"></Setter>
                    </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="ID">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Id}" HorizontalAlignment="Left"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn Header="Название автомата">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{StaticResource PrimaryColor}" Text="{Binding Name}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                   
                    <DataGridTemplateColumn Header="Модель">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ModelName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn Header="Компания владелец">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{StaticResource PrimaryColor}" Text="{Binding OwnerCompanyName}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn Header="Модем">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ModemNumber}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn Header="Адрес / Место">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="Address"></Binding>
                                            <Binding Path="Place"></Binding>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding DateInstalled}" Header="В работе с"></DataGridTextColumn>
                    <DataGridTemplateColumn Header="Действия">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Foreground="{StaticResource PrimaryColor}" Command="{Binding ElementName=Page,
                                        Path=((vm:VendingMachinesPageViewModel)DataContext).EditCommand}"
                                            CommandParameter="{Binding Id}">✏</Button>
                                    <Button Foreground="{StaticResource PrimaryColor}" Command="{Binding ElementName=Page,
                                        Path=((vm:VendingMachinesPageViewModel)DataContext).DeleteCommand}"
                                            CommandParameter="{Binding Id}">🗑</Button>
                                    <Button Foreground="{StaticResource PrimaryColor}" Command="{Binding ElementName=Page,
                                        Path=((vm:VendingMachinesPageViewModel)DataContext).DetachCommand}"
                                            CommandParameter="{Binding Id}">🔓</Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <ListBox MaxHeight="500" IsVisible="{Binding !TableRegime}" ItemsSource="{Binding Machines}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="5" LineSpacing="5"></WrapPanel>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="200" Spacing="5" Background="{StaticResource LightColor}">
                            <TextBlock TextWrapping="Wrap" Text="{Binding Id,
                            StringFormat={}ID: {0}}"></TextBlock>
                            <TextBlock  TextWrapping="Wrap" FontWeight="DemiBold" Text="{Binding Name}"></TextBlock>
                            <TextBlock  TextWrapping="Wrap"  Text="{Binding ModelName,
                            StringFormat={}Модель: {0}}"></TextBlock>
                            <TextBlock  TextWrapping="Wrap"  Text="{Binding OwnerCompanyName}"></TextBlock>
                            <TextBlock  TextWrapping="Wrap" FontWeight="DemiBold" Text="{Binding ModemNumber,
                            StringFormat={}Модем: {0}}"></TextBlock>
                            <TextBlock  TextWrapping="Wrap" >
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="Address"></Binding>
                                        <Binding Path="Place"></Binding>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock  TextWrapping="Wrap"  Text="{Binding DateInstalled,
                            StringFormat={}В работе с {0}}"></TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding ElementName=Page,
                                        Path=((vm:VendingMachinesPageViewModel)DataContext).EditCommand}"
                                        CommandParameter="{Binding Id}">✏</Button>
                                <Button Command="{Binding ElementName=Page,
                                        Path=((vm:VendingMachinesPageViewModel)DataContext).DeleteCommand}"
                                        CommandParameter="{Binding Id}">🗑</Button>
                                <Button Command="{Binding ElementName=Page,
                                        Path=((vm:VendingMachinesPageViewModel)DataContext).DetachCommand}"
                                        CommandParameter="{Binding Id}">🔓</Button>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Margin="5">
                <TextBlock HorizontalAlignment="Left" Text="{Binding TotalBlockText}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Command="{Binding PreviousPageCommand}">⬅️</Button>
                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="{Binding Color}"
                                        Command="{Binding ElementName=Page,
                                        Path=((vm:VendingMachinesPageViewModel)DataContext).ChoosePageNumberCommand}"
                                        CommandParameter="{Binding PageNumber}"
                                        Content="{Binding PageNumber}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Command="{Binding NextPageCommand}">➡️</Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
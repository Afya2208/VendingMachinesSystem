<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        xmlns:v="clr-namespace:DesktopApp.Views.Windows"
        x:DataType="v:PushWindow"
        x:Class="DesktopApp.Views.Windows.PushWindow"
        Title="Пуш-уведомление">
    <StackPanel Background="{Binding Color}">
        <TextBlock FontSize="30" Text="{Binding Symbol}"></TextBlock>
        <TextBlock Text="{Binding Text}"></TextBlock>
        <Button IsVisible="{Binding ShowSecondCrossButton}" 
                Click="CloseButton_OnClick">Закрыть</Button>
    </StackPanel>
</Window>
